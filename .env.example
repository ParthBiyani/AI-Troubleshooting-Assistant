# Copy to .env.local and fill in. Never commit real keys.

# Groq (primary LLM provider, free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (last-resort fallback, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback chain, tried in order. Model ids change often, so check each console.
# Format: provider:model,provider:model  (providers: groq, google)
LLM_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3-32b,groq:openai/gpt-oss-20b,google:gemini-2.5-flash-lite
